# Application
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=music-journal

# Optional: comma-separated browser origins when the frontend is hosted separately.
CORS_ORIGIN=
COOKIE_SAMESITE=lax

# Local smoke tests only. Never use the in-memory store in production.
# SESSION_STORE=memory
