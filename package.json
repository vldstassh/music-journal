{
  "name": "music-journal",
  "version": "1.0.0",
  "description": "Personal mood journal with an Express API and MongoDB persistence",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "app.js",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "start": "npm --workspace music-journal-backend start",
    "dev": "npm --workspace music-journal-backend run dev",
    "check": "npm --workspace music-journal-backend run check",
    "test": "npm --workspace music-journal-backend test",
    "test:watch": "npm --workspace music-journal-backend run test:watch"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true
  }
}
